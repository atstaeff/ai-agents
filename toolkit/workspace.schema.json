{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atstaeff.github.io/ai-agents/workspace.schema.json",
  "title": "Project manifest and legacy tooling configuration",
  "description": "Declarative ownership and process mapping. No connector, command execution or permission grant. Paths are relative to the project root.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "work": {
      "$ref": "#/$defs/location"
    },
    "review": {
      "$ref": "#/$defs/location"
    },
    "knowledge": {
      "$ref": "#/$defs/location"
    },
    "decisions": {
      "$ref": "#/$defs/location"
    },
    "iteration_reports": {
      "$ref": "#/$defs/location"
    },
    "communication": {
      "$ref": "#/$defs/location"
    },
    "working_agreement": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "stakeholders": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "commands": {
      "type": "object",
      "properties": {
        "setup": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "anyOf": [
            {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "method": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "location": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "path": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "default_branch": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "required": [
          "name",
          "location"
        ],
        "additionalProperties": false
      }
    },
    "planning": {
      "type": "object",
      "properties": {
        "priority": {
          "$ref": "#/$defs/location"
        },
        "iteration": {
          "$ref": "#/$defs/location"
        },
        "engineering_status": {
          "$ref": "#/$defs/location"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "states": {
          "type": "object",
          "properties": {
            "todo": {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            "in_progress": {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            "in_review": {
              "type": "string",
              "pattern": ".*\\S.*"
            },
            "done": {
              "type": "string",
              "pattern": ".*\\S.*"
            }
          },
          "required": [
            "todo",
            "in_progress",
            "in_review",
            "done"
          ],
          "additionalProperties": false
        },
        "blocked": {
          "const": "additional_property"
        },
        "completion_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "delivered",
              "cancelled",
              "duplicate",
              "not_implemented"
            ]
          },
          "uniqueItems": true,
          "minItems": 4
        },
        "code_done_requires": {
          "type": "array",
          "items": {
            "enum": [
              "criteria_evidence",
              "required_review",
              "integrated"
            ]
          },
          "uniqueItems": true,
          "minItems": 3
        }
      },
      "required": [
        "states",
        "blocked",
        "completion_reasons",
        "code_done_requires"
      ],
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "template": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "location",
        "template"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": ".*\\S.*"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "command": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "command",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "object",
      "properties": {
        "edit_assigned_branch": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "open_draft_pr": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "update_work_item": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "ask_questions": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "merge": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "deploy": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "delete": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        },
        "change_access": {
          "enum": [
            "within_assignment",
            "separate_authorization",
            "forbidden"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "description": "Version 2 requires explicit local Markdown references for project purpose and scope.",
      "properties": {
        "vision": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "goals": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "scope_and_boundaries": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "vision",
        "goals",
        "scope_and_boundaries"
      ],
      "additionalProperties": false
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "project_name": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "responsibilities": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "contribution_guide": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "delivery_method": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "work_tracking": {
      "$ref": "#/$defs/location"
    },
    "code_review": {
      "$ref": "#/$defs/location"
    },
    "knowledge_base": {
      "$ref": "#/$defs/location"
    },
    "decision_records": {
      "$ref": "#/$defs/location"
    },
    "progress_reporting": {
      "$ref": "#/$defs/location"
    }
  },
  "required": [],
  "additionalProperties": false,
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "location": {
          "type": "string",
          "pattern": ".*\\S.*"
        }
      },
      "required": [
        "system",
        "location"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "schema_version",
          "project_name",
          "context",
          "responsibilities",
          "contribution_guide",
          "work_tracking",
          "code_review",
          "knowledge_base",
          "decision_records",
          "communication"
        ],
        "propertyNames": {
          "enum": [
            "schema_version",
            "project_name",
            "context",
            "responsibilities",
            "contribution_guide",
            "delivery_method",
            "work_tracking",
            "code_review",
            "knowledge_base",
            "decision_records",
            "progress_reporting",
            "profile",
            "repositories",
            "planning",
            "flow",
            "handoff",
            "labels",
            "reviewers",
            "commands",
            "quality_gates",
            "actions",
            "communication"
          ]
        }
      },
      "else": {
        "required": [
          "version",
          "name",
          "work",
          "review",
          "knowledge",
          "decisions",
          "iteration_reports",
          "communication",
          "working_agreement",
          "stakeholders"
        ],
        "propertyNames": {
          "enum": [
            "version",
            "name",
            "work",
            "review",
            "knowledge",
            "decisions",
            "iteration_reports",
            "communication",
            "working_agreement",
            "stakeholders",
            "commands",
            "profile",
            "method",
            "repositories",
            "planning",
            "flow",
            "handoff",
            "labels",
            "reviewers",
            "quality_gates",
            "actions"
          ]
        }
      }
    }
  ]
}
